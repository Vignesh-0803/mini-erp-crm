generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum ProductCategory {
  HARDWARE
  ELECTRONICS
  RAW_MATERIALS
  FINISHED_GOODS
  GENERAL
}

enum StockType {
  IN
  OUT
}

model Customer {
  id           String         @id @default(uuid())
  name         String
  mobile       String
  email        String
  businessName String
  gstNumber    String?
  type         CustomerType   @default(WHOLESALE)
  address      String
  status       CustomerStatus @default(LEAD)
  followUpDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  challans     Challan[]
}

model Product {
  id            String            @id @default(uuid())
  name          String
  sku           String            @unique
  category      ProductCategory   @default(GENERAL)
  unitPrice     Float
  currentStock  Int               @default(0)
  minStockAlert Int               @default(5)
  location      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  movements     StockMovement[]
  challanItems  ChallanItem[]
}

model StockMovement {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  type      StockType
  quantity  Int
  reason    String?
  createdAt DateTime  @default(now())
}

model Challan {
  id            String        @id @default(uuid())
  challanNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        String        @default("DRAFT")
  items         ChallanItem[]
  createdAt     DateTime      @default(now())
}

model ChallanItem {
  id        String  @id @default(uuid())
  challanId String
  challan   Challan @relation(fields: [challanId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}